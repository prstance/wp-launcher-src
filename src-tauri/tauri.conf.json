{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wii Party Launcher",
  "version": "0.3.5",
  "identifier": "dev.wiiparty.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/fetch-tools.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-tools.mjs --strict && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wii Party Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "maxWidth": 1280,
        "maxHeight": 720,
        "maximizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Lance Wii Party avec tes mods",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "tools/": "tools/",
      "versions/": "versions/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMDhGOTczMjZFQTY5ODUKUldTRmFlb21jL2tJdktqcE5sN1d0Z1J1Sk5lM1ppV29sVXVXS01qbldXR2pDcmtUaTNTcUg0bUoK",
      "endpoints": [
        "https://github.com/prstance/wp-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
