{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wii Party Launcher",
  "version": "0.1.0",
  "identifier": "dev.wiiparty.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/fetch-tools.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-tools.mjs --strict && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wii Party Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Lance Wii Party avec tes mods",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "tools/": "tools/",
      "versions/": "versions/"
    }
  }
}
